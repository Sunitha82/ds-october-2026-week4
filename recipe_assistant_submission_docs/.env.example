# Configuration template only. Never put real credentials in this file.
# Use the resource endpoint WITHOUT the /openai/v1/ suffix.
AZURE_OPENAI_ENDPOINT=https://YOUR_RESOURCE_NAME.openai.azure.com
AZURE_OPENAI_API_KEY=YOUR_AZURE_OPENAI_API_KEY
# Set this to the exact deployment name supplied for your Azure resource.
AZURE_OPENAI_DEPLOYMENT=YOUR_DEPLOYMENT_NAME
